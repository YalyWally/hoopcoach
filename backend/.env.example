# Copy this file to .env and fill in your key to enable the real AI coach & AI nutrition estimation.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
PORT=4000
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Only needed when deploying (e.g. to Netlify) — leave blank for local dev,
# which falls back to a local SQLite file (backend/data.db) automatically. ---

# A Turso (libSQL) database — see README.md "Deploying to Netlify".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Web Push (VAPID) keypair — generate once with `npm run generate-vapid-keys`
# and paste the result here / into your host's env vars. Leave blank locally;
# a keypair is auto-generated into backend/vapid.json for you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
